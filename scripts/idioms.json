  "at seven": ["a las siete"],
  "at eight": ["a las ocho"],
  "at nine": ["a las nueve"],
  "at ten": ["a las diez"],
  "at eleven": ["a las once"],
  "at twelve": ["a las doce"],
  "at noon": ["a mediodía", "al mediodía"],
  "at midnight": ["a medianoche", "a la medianoche"]
